{
    "env": {
        "browser": true,
        "es2021": true,
        "mocha": true
    },
    "extends": ["standard"],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": 13,
        "sourceType": "module"
    },
    "plugins": ["@typescript-eslint"],
    "rules": {
        "semi": [2, "always"],
        "indent": [
            "error",
            4,
            {
                "MemberExpression": "off",
                "SwitchCase": 1
            }
        ],
        "eqeqeq": "off",
        "space-before-function-paren": "off",
        "comma-dangle": "off",
        "no-unused-vars": "off",
        "camelcase": "off",
        "@typescript-eslint/no-unused-vars": "error",
        "@typescript-eslint/naming-convention": [
            "error",
            {
                "selector": "property",
                "format": null,
                "filter": {
                    "regex": ".*_DEPRECATED$",
                    "match": true
                }
            },
            {
                "selector": "property",
                "format": ["camelCase", "PascalCase", "UPPER_CASE"],
                "filter": {
                    "regex": "(.*_DEPRECATED(_.*)?$)|(space_NOT_USED_IN_SLOT)",
                    "match": false
                }
            }
        ]
    }
}
